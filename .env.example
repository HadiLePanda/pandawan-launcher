# Pandawan Launcher - CDN Environment Configuration
# There is no dev-only default: this value is the only thing that decides where the
# CDN is read from. Left unset the launcher reads the public R2 bucket.
# The localhost value below is a PLACEHOLDER - there is no bundled example server in
# this repo, so point it at a real CDN (or your own static server) before launching.
VITE_CDN_ORIGIN=http://localhost:8765

# Publishing (scripts/publish-game.mjs) reads these from .env, which is
# gitignored. Copy this block into .env and fill in real values.
# NEVER commit real values: put them in .env only.
#
# R2_ACCOUNT_ID   Cloudflare dashboard -> R2 -> Account ID
#                 (this is NOT in the r2.dev subdomain URL)
# R2_BUCKET       the bucket name shown in the R2 dashboard, e.g. your-bucket-name
# R2_CDN_ORIGIN   public bucket URL, e.g. https://pub-abc123.r2.dev
# R2_ACCESS_KEY_ID     R2 -> Manage R2 tokens -> Create API token
# R2_SECRET_ACCESS_KEY same, shown only once
