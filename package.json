{
  "name": "pandawan-launcher",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "tauri:dev": "node scripts/sync-updater-key.cjs && tauri dev",
    "tauri:build": "node scripts/build-signed.cjs",
    "sync:updater-key": "node scripts/sync-updater-key.cjs",
    "keys:check": "node scripts/check-updater-keys.cjs",
    "keys:generate": "node scripts/check-updater-keys.cjs --generate",
    "publish:game": "node scripts/publish-game.mjs",
    "publish:catalog": "node scripts/publish-catalog.mjs",
    "publish:meta": "node scripts/publish-metadata.mjs",
    "publish:news": "node scripts/publish-news.mjs",
    "bindings:export": "cargo run --manifest-path src-tauri/export-bindings/Cargo.toml",
    "prune:builds": "node scripts/prune-builds.mjs",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/publish-launcher.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "dashboard:build": "node scripts/dashboard/app/run-build.cjs",
    "backfill:latest": "node scripts/backfill-latest.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.0.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "postcss": "^8.5.16",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^5.0.3"
  }
}
