{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pandawan Launcher",
  "version": "0.4.2",
  "identifier": "com.pandawancorp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pandawan Launcher",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": true,
        "windowEffects": {
          "effects": [],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://pub-789d1bb0f3da4a99ae1024d53ea305d3.r2.dev data:; connect-src 'self' https://pub-789d1bb0f3da4a99ae1024d53ea305d3.r2.dev; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none';",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http://localhost:* http://127.0.0.1:* data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none';",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/com.pandawancorp.launcher/**", "$APPDATA/PandawanGames/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://pub-789d1bb0f3da4a99ae1024d53ea305d3.r2.dev/launcher/latest.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2RDY4NDEzNkNCN0Y3NjcKUldSbjk3ZHNFNFRXTmtUcGcvbHVMVTBFWFJJdk5jSXpST2htUHgxbjY4aVRCMEpuN3gvVlRIWkwK"
    }
  }
}
