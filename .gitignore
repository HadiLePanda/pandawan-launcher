downloads/

# Runtime artifact written by the test game when launched
test-game-ran.txt

# Output from run-dev.bat / build-installer.bat
dev-launch.log
build-launch.log

# Downloaded release assets staged by scripts/publish-launcher.mjs (~50 MB of
# installers); recreated on every publish, never committed.
.publish/

# Minisign updater keys
src-tauri/.secrets/
*.key

# Hermes temp files
.hermes-tmp.*

# Python bytecode. generate-manifest.py and the skills' helper scripts run
# locally, so this appears in the working tree after any of them is invoked and is
# never something to commit.
__pycache__/
*.py[cod]
*$py.class

# Scratch commit message; created outside the repo where possible
COMMIT_MSG.txt

# Agent skills. Installed per-machine by the tooling (npx skills add ...), so
# they belong to the developer setup rather than to the project. Nothing here is
# needed to build, test or publish.
.agents/
.hermes/

# tsc -b / composite project output
*.tsbuildinfo

# Internal-only material, kept on the developer's machine and NEVER published.
# The repo is made public only so CI can run against it, so nothing
# company-specific may stay tracked: agent tooling, skills and internal plans
# are untracked here and live in the working tree only.
.agents/
.claude/
.codex/
skills-lock.json
docs/superpowers/
.github/agents/
.github/hooks/
.github/skills/
# A local scratch notes file, never part of the project.
IDEA.md
